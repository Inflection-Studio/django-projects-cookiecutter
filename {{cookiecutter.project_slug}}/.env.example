SECRET_KEY=
DEBUG=True
ENVIRONMENT=local
DJANGO_SETTINGS_MODULE={{cookiecutter.project_slug}}.conf.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Database configuration
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME={{cookiecutter.project_slug}}
DB_USER=
DB_PASSWORD=
DB_HOST={% if cookiecutter.use_docker == 'y' %}postgres {% else %}localhost{% endif %}
DB_PORT=5432
LC_ALL=C.UTF-8

# Postgres admin configuration
PGADMIN_DEFAULT_EMAIL=${DEFAULT_FROM_EMAIL}
PGADMIN_DEFAULT_PASSWORD=${DB_PASSWORD}

# Email configuration
USE_SMTP=False
DEFAULT_FROM_EMAIL=accounts@{{cookiecutter.domain_name}}
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=2525
