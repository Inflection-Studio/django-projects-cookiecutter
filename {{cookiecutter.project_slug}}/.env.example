SECRET_KEY=
DEBUG=True
ENVIRONMENT=local
DJANGO_SETTINGS_MODULE={{cookiecutter.project_slug}}.conf.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Database configuration
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME={{cookiecutter.project_slug}}
DB_USER=
DB_PASSWORD=
DB_HOST={% if cookiecutter.use_docker == 'y' %}postgres {% else %}localhost{% endif %}
DB_PORT=5432
LC_ALL=C.UTF-8

# Postgres admin configuration
PGADMIN_DEFAULT_EMAIL=admin@{{cookiecutter.domain_name}}
PGADMIN_DEFAULT_PASSWORD=${DB_PASSWORD}

# Email configuration
DEFAULT_FROM_EMAIL=accounts@{{cookiecutter.domain_name}}
SERVER_EMAIL=accounts@{{cookiecutter.domain_name}}
SUPPORT_FROM_EMAIL=support@{{cookiecutter.domain_name}}
CONTACT_EMAIL_RECIPIENTS=support@{{cookiecutter.domain_name}}
{% if cookiecutter.mail_service == "Mailgun" %}
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN={{cookiecutter.domain_name}}
ANYMAIL_REQUESTS_TIMEOUT=30
{% elif cookiecutter.mail_service == "Amazon SES" %}
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
{% elif cookiecutter.mail_service == "Mailjet" %}
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
ANYMAIL_REQUESTS_TIMEOUT=30
{% elif cookiecutter.mail_service == "Mandrill" %}
MANDRILL_API_KEY=
ANYMAIL_REQUESTS_TIMEOUT=30
{% elif cookiecutter.mail_service == "Postmark" %}
POSTMARK_SERVER_TOKEN=
ANYMAIL_REQUESTS_TIMEOUT=30
{% elif cookiecutter.mail_service == "SendGrid" %}
SENDGRID_API_KEY=
ANYMAIL_REQUESTS_TIMEOUT=30
{% elif cookiecutter.mail_service == "Brevo" %}
BREVO_API_KEY=
ANYMAIL_REQUESTS_TIMEOUT=30
{% elif cookiecutter.mail_service == "SparkPost" %}
SPARKPOST_API_KEY=
ANYMAIL_REQUESTS_TIMEOUT=30
{% else %}
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30
{% endif %}
